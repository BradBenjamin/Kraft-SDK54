
--
-- Name: categories; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.categories (
    id bigint NOT NULL,
    name text NOT NULL,
    icon text NOT NULL,
    image text NOT NULL
);


ALTER TABLE public.categories OWNER TO postgres;

--
-- Name: categories_id_seq; Type: SEQUENCE; Schema: public; Owner: postgres
--

ALTER TABLE public.categories ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY (
    SEQUENCE NAME public.categories_id_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1
);


--
-- Name: crafter_applications; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.crafter_applications (
    id bigint NOT NULL,
    user_id uuid NOT NULL,
    category_id bigint,
    description text,
    status text DEFAULT 'pending'::text,
    created_at timestamp with time zone DEFAULT timezone('utc'::text, now()) NOT NULL
);


ALTER TABLE public.crafter_applications OWNER TO postgres;

--
-- Name: crafter_applications_id_seq; Type: SEQUENCE; Schema: public; Owner: postgres
--

ALTER TABLE public.crafter_applications ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY (
    SEQUENCE NAME public.crafter_applications_id_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1
);


--
-- Name: profiles; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.profiles (
    id uuid NOT NULL,
    email text,
    full_name text,
    avatar_url text,
    created_at timestamp with time zone DEFAULT timezone('utc'::text, now()) NOT NULL
);


ALTER TABLE public.profiles OWNER TO postgres;

--
-- Name: taskers; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.taskers (
    id bigint NOT NULL,
    name text NOT NULL,
    rating numeric NOT NULL,
    reviews integer NOT NULL,
    tasks integer NOT NULL,
    tags text[] NOT NULL,
    rate integer NOT NULL,
    is_online boolean DEFAULT false,
    image text NOT NULL,
    user_id uuid
);


ALTER TABLE public.taskers OWNER TO postgres;

--
-- Name: taskers_id_seq; Type: SEQUENCE; Schema: public; Owner: postgres
--

ALTER TABLE public.taskers ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY (
    SEQUENCE NAME public.taskers_id_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1
);


--
-- Name: refresh_tokens id; Type: DEFAULT; Schema: auth; Owner: supabase_auth_admin
--

ALTER TABLE ONLY auth.refresh_tokens ALTER COLUMN id SET DEFAULT nextval('auth.refresh_tokens_id_seq'::regclass);


